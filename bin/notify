#!/usr/bin/env bash
# notify [--chat <chat_id>] [--thread <thread_id>] [--md|--html] [--dry-run]
#        [--photo <path|url>]... [--file <path|url>]... [message...]
#
# Push a message to the linked Telegram chat, independent of the relay
# process. Reads the bot token and default chat id from the relay's settings
# DB (data/app.db), same as safe-update-relay — so it works even while the
# relay is down or mid-restart.
#
# Message comes from the args, or from stdin when no message args are given
# (e.g. `claude -p "..." | bin/notify`). Long messages are sent in chunks.
#
# Options:
#   --chat <id>     target chat id (default: the linked telegram_chat_id)
#   --thread <id>   message_thread_id, for linked group topics
#   --md            send as a rich message (sendRichMessage, GitHub-Flavored
#                   Markdown — best for agent output; falls back to plain
#                   text if the API rejects it)
#   --html          send with parse_mode=HTML (default: plain text — safest
#                   for arbitrary/piped output, which HTML mode would reject)
#   --photo <path|url>  send an image (local file or http(s) URL). Repeatable.
#                   The message, if any, becomes the caption of the last
#                   attachment (sent as a separate text message instead when
#                   it is over 1024 chars or --md is set). A local image
#                   Telegram won't take as a photo (over 10 MB, extreme
#                   dimensions) is retried as a file.
#   --file <path|url>   send any file as a document, uncompressed (max 50 MB).
#                   Repeatable; same caption rule as --photo.
#   --dry-run       print the request bodies instead of sending
#
# With --photo/--file the message is optional and is never read from stdin.
#
# Delivery path: sends addressed to the default linked chat are routed through
# the relay's POST /api/notify when the relay is up — that logs the message to
# the dashboard feed and queues it as context for the agent's next turn. When
# the relay is down (or the send targets --chat/--thread), falls back to the
# direct Telegram API and best-effort records the same bookkeeping straight
# into the DB.
#
# Env: RELAY_DB overrides the settings DB path; RELAY_URL overrides the relay
# base URL (default: tries http://127.0.0.1:$PORT, then :8000, then :3000);
# NOTIFY_TOKEN is forwarded as X-Notify-Token if the relay requires one.

set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DB="${RELAY_DB:-$REPO_DIR/data/app.db}"

CHAT_ID=""
CHAT_OVERRIDE=0
THREAD_ID=""
HTML=0
MD=0
DRY_RUN=0
MSG_ARGS=()
# Attachments, in send order: ATT_KINDS[i] is "photo" or "document",
# ATT_SRCS[i] a local path or an http(s) URL.
ATT_KINDS=()
ATT_SRCS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --chat)    CHAT_ID="${2:?--chat needs a value}"; CHAT_OVERRIDE=1; shift 2 ;;
    --thread)  THREAD_ID="${2:?--thread needs a value}"; shift 2 ;;
    --md)      MD=1; shift ;;
    --html)    HTML=1; shift ;;
    --photo)   ATT_KINDS+=(photo); ATT_SRCS+=("${2:?--photo needs a path or URL}"); shift 2 ;;
    --file)    ATT_KINDS+=(document); ATT_SRCS+=("${2:?--file needs a path or URL}"); shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         MSG_ARGS+=("$1"); shift ;;
  esac
done

if [ "$MD" = 1 ] && [ "$HTML" = 1 ]; then
  echo "notify: --md and --html are mutually exclusive" >&2
  exit 1
fi

N_ATT=${#ATT_SRCS[@]}

# Fail before sending anything if a local attachment is missing.
i=0
while [ "$i" -lt "$N_ATT" ]; do
  case "${ATT_SRCS[$i]}" in
    http://*|https://*) ;;
    *) if [ ! -f "${ATT_SRCS[$i]}" ]; then
         echo "notify: no such file: ${ATT_SRCS[$i]}" >&2
         exit 1
       fi ;;
  esac
  i=$((i + 1))
done

if [ ${#MSG_ARGS[@]} -gt 0 ]; then
  MSG="${MSG_ARGS[*]}"
elif [ "$N_ATT" -gt 0 ]; then
  MSG=""   # attachment-only send; don't block on stdin
else
  MSG="$(cat)"
fi
# Empty message → silent no-op, so `agent-check | notify` cron jobs that
# output nothing on quiet runs don't error or trigger cron mail. (Glob match,
# not ${MSG//…/} substitution: the latter is quadratic in bash and hangs for
# minutes on large piped input.)
if [[ "$MSG" != *[![:space:]]* ]]; then
  [ "$N_ATT" -gt 0 ] || exit 0
  MSG=""
fi

# The md loop below consumes $MSG chunk by chunk; keep the original for the
# direct-path bookkeeping.
ORIG_MSG="$MSG"
# Default-chat sends get relay routing + agent-context bookkeeping; targeted
# sends (--chat/--thread) go direct and stay out of the private conversation's
# context queue.
DEFAULT_CHAT=1
if [ "$CHAT_OVERRIDE" = 1 ] || [ -n "$THREAD_ID" ]; then
  DEFAULT_CHAT=0
fi

# Try the relay's /api/notify; 0 = accepted (message delivered + logged +
# queued as agent context — nothing left to do).
relay_send() {
  [ "$DEFAULT_CHAT" = 1 ] || return 1
  [ "$DRY_RUN" = 0 ] || return 1
  local fmt="plain"
  [ "$HTML" = 1 ] && fmt="html"
  [ "$MD" = 1 ] && fmt="md"
  local body base code
  body="$(jq -n --arg t "$ORIG_MSG" --arg f "$fmt" \
    '{text: $t, format: $f, source: "notify"}')"
  for base in ${RELAY_URL:-} ${PORT:+http://127.0.0.1:$PORT} \
              http://127.0.0.1:8000 http://127.0.0.1:3000; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 30 -X POST "$base/api/notify" \
      -H 'Content-Type: application/json' \
      ${NOTIFY_TOKEN:+-H "X-Notify-Token: $NOTIFY_TOKEN"} \
      -d "$body" 2>/dev/null)"
    [ "$code" = "200" ] && return 0
  done
  return 1
}

# Direct-path bookkeeping: the relay wasn't involved, so record the message in
# its DB ourselves — a dashboard-feed row plus context for the agent's next
# turn. Best-effort: never fails the send.
record_direct() {
  [ "$DEFAULT_CHAT" = 1 ] || return 0
  [ "$DRY_RUN" = 0 ] || return 0
  local now esc text="${1:-$ORIG_MSG}"
  now="$(($(date +%s) * 1000))"
  esc="${text//\'/\'\'}"
  sqlite3 "$DB" "
    CREATE TABLE IF NOT EXISTS pending_context (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      created_at INTEGER NOT NULL,
      source TEXT NOT NULL,
      kind TEXT,
      text TEXT NOT NULL,
      session_key TEXT NOT NULL DEFAULT 'claude_session_id'
    );
    INSERT INTO message_log (created_at, direction, text, session_id, ok, error)
      VALUES ($now, 'out', '[notify] ' || '$esc', NULL, 1, NULL);
    INSERT INTO pending_context (created_at, source, text)
      VALUES ($now, 'notify', substr('$esc', 1, 1500));
  " 2>/dev/null || true
}

# Bot token + chat id for the direct Telegram path; exits when unconfigured.
load_direct_config() {
  [ -z "${TOKEN:-}" ] || return 0
  TOKEN="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='telegram_bot_token'" 2>/dev/null || true)"
  if [ -z "$CHAT_ID" ]; then
    CHAT_ID="$(sqlite3 "$DB" "SELECT value FROM settings WHERE key='telegram_chat_id'" 2>/dev/null || true)"
  fi
  if [ -z "$TOKEN" ]; then
    echo "notify: no telegram_bot_token in $DB" >&2
    exit 1
  fi
  if [ -z "$CHAT_ID" ]; then
    echo "notify: no chat id — link a chat in the dashboard or pass --chat" >&2
    exit 1
  fi
}

# Attachments always go straight to Telegram (the relay's /api/notify is
# text-only), as a multipart upload for local files or by URL.
#
# send_attachment <method> <field> <src> <caption> → 0 if accepted; $RESP.
send_attachment() {
  local method="$1" field="$2" src="$3" caption="$4" value
  case "$src" in
    http://*|https://*) value="$src" ;;
    # curl -F reads `;` and `,` in an @path as option separators — quote it.
    *) value="@\"${src//\"/\\\"}\"" ;;
  esac
  local args=(-F "chat_id=$CHAT_ID" -F "$field=$value")
  [ -z "$THREAD_ID" ] || args+=(-F "message_thread_id=$THREAD_ID")
  if [ -n "$caption" ]; then
    # --form-string: a caption starting with @ or < must not be read as a file.
    args+=(--form-string "caption=$caption")
    [ "$HTML" = 0 ] || args+=(-F "parse_mode=HTML")
  fi
  if [ "$DRY_RUN" = 1 ]; then
    printf '%s' "$method"; printf ' %q' "${args[@]}"; echo
    return 0
  fi
  RESP="$(curl -s --max-time 180 -X POST \
    "https://api.telegram.org/bot${TOKEN}/$method" "${args[@]}")"
  echo "$RESP" | jq -e '.ok == true' >/dev/null 2>&1
}

if [ "$N_ATT" -gt 0 ]; then
  load_direct_config
  # Captions cap at 1024 chars and can't be rich messages; otherwise the text
  # rides on the last attachment and there is nothing left to send after.
  CAPTION=""
  if [ -n "$MSG" ] && [ "$MD" = 0 ] && [ "${#MSG}" -le 1024 ]; then
    CAPTION="$MSG"
  fi
  i=0
  while [ "$i" -lt "$N_ATT" ]; do
    kind="${ATT_KINDS[$i]}"
    src="${ATT_SRCS[$i]}"
    cap=""
    [ "$i" -lt $((N_ATT - 1)) ] || cap="$CAPTION"
    if [ "$kind" = photo ]; then
      if ! send_attachment sendPhoto photo "$src" "$cap"; then
        case "$src" in
          http://*|https://*)
            echo "notify: photo send failed: $RESP" >&2
            exit 1 ;;
        esac
        echo "notify: photo rejected ($RESP); sending as a file" >&2
        kind=document
      fi
    fi
    if [ "$kind" = document ] && ! send_attachment sendDocument document "$src" "$cap"; then
      echo "notify: file send failed: $RESP" >&2
      exit 1
    fi
    record_direct "[$kind: $src]${cap:+ $cap}"
    i=$((i + 1))
  done
  if [ -n "$CAPTION" ] || [ -z "$MSG" ]; then
    exit 0
  fi
fi

if relay_send; then
  exit 0
fi

load_direct_config

# Telegram caps plain messages at 4096 UTF-16 code units and rich messages at
# 32768 UTF-8 characters; chunk conservatively (bash slices by codepoint, and
# emoji count double in UTF-16).
MAX_PLAIN=3500
MAX_MD=30000

# tg_post <method> <body> → 0 if Telegram accepted; response in $RESP.
tg_post() {
  RESP="$(curl -s --max-time 15 -X POST \
    "https://api.telegram.org/bot${TOKEN}/$1" \
    -H 'Content-Type: application/json' -d "$2")"
  echo "$RESP" | jq -e '.ok == true' >/dev/null 2>&1
}

# send_plain <text> — chunked sendMessage; honors $HTML; exits on failure.
send_plain() {
  local rest="$1" chunk body
  while [ -n "$rest" ]; do
    chunk="${rest:0:$MAX_PLAIN}"
    rest="${rest:$MAX_PLAIN}"
    body="$(jq -n --arg cid "$CHAT_ID" --arg t "$chunk" --arg tid "$THREAD_ID" \
      --argjson html "$HTML" \
      '{chat_id: $cid, text: $t, disable_web_page_preview: true}
       + (if $tid != "" then {message_thread_id: ($tid | tonumber)} else {} end)
       + (if $html == 1 then {parse_mode: "HTML"} else {} end)')"
    if [ "$DRY_RUN" = "1" ]; then
      echo "$body"
      continue
    fi
    if ! tg_post sendMessage "$body"; then
      echo "notify: send failed: $RESP" >&2
      exit 1
    fi
  done
}

if [ "$MD" = 1 ]; then
  while [ -n "$MSG" ]; do
    CHUNK="${MSG:0:$MAX_MD}"
    MSG="${MSG:$MAX_MD}"
    BODY="$(jq -n --arg cid "$CHAT_ID" --arg t "$CHUNK" --arg tid "$THREAD_ID" \
      '{chat_id: $cid, rich_message: {markdown: $t}}
       + (if $tid != "" then {message_thread_id: ($tid | tonumber)} else {} end)')"
    if [ "$DRY_RUN" = "1" ]; then
      echo "$BODY"
      continue
    fi
    if ! tg_post sendRichMessage "$BODY"; then
      echo "notify: rich send failed ($RESP); falling back to plain text" >&2
      send_plain "$CHUNK"
    fi
  done
else
  send_plain "$MSG"
fi

record_direct
