#!/usr/bin/env bash
# doctor — report install status of every dependency. Read-only; installs
# nothing. Exits non-zero if a core dependency is missing or no agent CLI is
# present, so it's safe to use as a preflight check.
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_deps.sh
. "$DIR/_deps.sh"

missing=0
echo "Core dependencies:"
for d in "${CORE_DEPS[@]}"; do
  if have "$d"; then
    printf '  %s✓%s %-8s %s%s%s\n' "$C_OK" "$C_RST" "$d" "$C_DIM" "$(version_of "$d")" "$C_RST"
  else
    printf '  %s✗%s %-8s %smissing%s\n' "$C_BAD" "$C_RST" "$d" "$C_BAD" "$C_RST"
    missing=$((missing + 1))
  fi
done

echo
echo "Coding agent CLIs (need at least one):"
agents=0
for d in "${AGENT_CLIS[@]}"; do
  if have "$d"; then
    printf '  %s✓%s %-8s %s%s%s\n' "$C_OK" "$C_RST" "$d" "$C_DIM" "$(version_of "$d")" "$C_RST"
    agents=$((agents + 1))
  else
    printf '  %s•%s %-8s %snot found — %s%s\n' "$C_WARN" "$C_RST" "$d" "$C_DIM" "$(agent_hint "$d")" "$C_RST"
  fi
done

echo
echo "Agent skills (required):"
for s in "${REQUIRED_SKILLS[@]}"; do
  if have_skill "$s"; then
    printf '  %s✓%s %s\n' "$C_OK" "$C_RST" "$s"
  else
    printf '  %s✗%s %s %smissing — %s/install installs it (npx skills add %s --skill %s -g)%s\n' "$C_BAD" "$C_RST" "$s" "$C_DIM" "$DIR" "$SKILLS_REPO" "$s" "$C_RST"
    missing=$((missing + 1))
  fi
done

echo
echo "Host:"
mem_avail=""
if [ -r /proc/meminfo ]; then
  mem_avail="$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo)"
  mem_total="$(awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo)"
  swap_total="$(awk '/^SwapTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo)"
  low_mb="${LOW_MEMORY_MB:-512}"
  if [ -n "$mem_avail" ] && [ "$mem_avail" -lt "$low_mb" ]; then
    printf '  %s!%s memory   %s MB available of %s MB — below LOW_MEMORY_MB=%s; run bin/preview list / pm2 ls\n' "$C_WARN" "$C_RST" "$mem_avail" "$mem_total" "$low_mb"
  else
    printf '  %s✓%s memory   %s MB available of %s MB\n' "$C_OK" "$C_RST" "${mem_avail:-?}" "${mem_total:-?}"
  fi
  if [ "${swap_total:-0}" -eq 0 ]; then
    printf '  %s•%s swap     none — an OOM is abrupt instead of gradual; consider a swapfile\n' "$C_WARN" "$C_RST"
  else
    printf '  %s✓%s swap     %s MB\n' "$C_OK" "$C_RST" "$swap_total"
  fi
else
  printf '  %s•%s memory   %snot Linux — no /proc/meminfo (relay guard uses vm_stat on macOS, is off elsewhere)%s\n' "$C_DIM" "$C_RST" "$C_DIM" "$C_RST"
fi
if have pm2 && have jq; then
  n_prev="$(jq 'length' "$DIR/../data/previews.json" 2>/dev/null || echo 0)"
  printf '  %s•%s previews %s registered via bin/preview (PREVIEW_MAX=%s)\n' "$C_DIM" "$C_RST" "$n_prev" "${PREVIEW_MAX:-4}"
fi

echo
if [ "$missing" -gt 0 ]; then
  echo "${C_BAD}${missing} dependency(ies) missing.${C_RST} Run: ${DIR}/install"
fi
if [ "$agents" -eq 0 ]; then
  echo "${C_WARN}No coding agent CLI found.${C_RST} Install Claude Code (see hints above)."
fi
if [ "$missing" -eq 0 ] && [ "$agents" -gt 0 ]; then
  echo "${C_OK}All set.${C_RST}"
fi

# Non-zero if anything critical (core dep or required skill) is missing.
[ "$missing" -eq 0 ] && [ "$agents" -gt 0 ]
